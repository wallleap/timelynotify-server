#!/usr/bin/env bash
# docker compose 部署 timelynotify-server
# 默认使用本地构建镜像 (deploy/docker-compose.local.yaml)，如需远程镜像:
#   COMPOSE_FILE=deploy/docker-compose.yaml bin/up
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

COMPOSE_FILE="${COMPOSE_FILE:-$ROOT/deploy/docker-compose.local.yaml}"

exec docker compose -f "$COMPOSE_FILE" up -d --build "$@"
